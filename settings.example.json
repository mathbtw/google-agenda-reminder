{
  "SyncIntervalMinutes": 3,
  "LookAheadDays": 14,

  "Reminders": {
    "Event":    { "NotificationEnabled": true, "NotificationMinutes": [10], "FullScreenEnabled": true,  "FullScreenMinutes": [2] },
    "Task":     { "NotificationEnabled": true, "NotificationMinutes": [10], "FullScreenEnabled": true,  "FullScreenMinutes": [0] },
    "Birthday": { "NotificationEnabled": true, "NotificationMinutes": [0],  "FullScreenEnabled": false, "FullScreenMinutes": [] }
  },
  "GoogleRemindersStyle": "Toast",

  "Colors": { "Event": "#4C8BF5", "Task": "#34C38F", "Birthday": "#F5A04C" },
  "UseGoogleCalendarColors": false,

  "AllDayReminderTime": "09:00",
  "BirthdayReminderTime": "09:00",
  "DefaultTaskTime": "09:00",
  "EnableWebTaskTimes": false,
  "WebTaskTimesRefreshMinutes": 30,

  "Blacklist": [
    { "Process": "obs64.exe", "Action": "ToastOnly" },
    { "Process": "valorant.exe", "Action": "Postpone" },
    { "Process": "vlc.exe", "Action": "Silent" }
  ],
  "AutoDetectFullscreenApps": true,
  "AutoDetectAction": "Postpone",
  "MaxPostponeMinutes": 120,

  "SnoozeOptionsMinutes": [5, 10, 30],
  "ToastDurationSeconds": 20,
  "MissedReminderGraceMinutes": 60,
  "PlaySound": true,
  "CheckForUpdates": true,
  "IgnoredCalendarIds": []
}
