<Window x:Class="AgendaReminder.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agenda Reminder"
        Icon="/Assets/app.ico"
        Width="1040" Height="700" MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Grid.Column="0" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel Margin="14,16,14,14">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,20">
                        <Image Source="/Assets/app.ico" Width="26" Height="26" />
                        <TextBlock Text="Agenda Reminder" FontSize="16" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Compte affiché" Style="{StaticResource Caption}" Margin="4,0,0,4" />
                    <ComboBox x:Name="AccountSwitcher" SelectionChanged="OnAccountSwitched" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="4,0,0,8" />
                    <Button x:Name="SyncButton" HorizontalAlignment="Stretch" Click="OnSync">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE895;" VerticalAlignment="Center" />
                            <TextBlock Text="Synchroniser" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ListBox x:Name="Nav" Margin="0,18,0,0" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnNavigate">
                    <ListBoxItem Tag="upcoming">
                        <StackPanel Orientation="Horizontal" Margin="2,4">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE787;" Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="À venir" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="tasks">
                        <StackPanel Orientation="Horizontal" Margin="2,4">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D5;" Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="Tâches" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="accounts">
                        <StackPanel Orientation="Horizontal" Margin="2,4">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="Comptes" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings">
                        <StackPanel Orientation="Horizontal" Margin="2,4">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="Paramètres" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Contenu -->
        <DockPanel Grid.Column="1">
            <!-- Bandeau de mise à jour -->
            <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="28,14,28,0"
                    Padding="14,10" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                <DockPanel>
                    <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Click="OnInstallUpdate" />
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE895;" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <ContentControl x:Name="PageHost" Margin="28,20,28,16" Focusable="False" />
        </DockPanel>
    </Grid>
</Window>
