<Window x:Class="AgendaReminder.App.Views.Dialogs.NewEventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvel évènement"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22,18,22,18">
        <TextBox x:Name="TitleBox" FontSize="15" Margin="0,0,0,14" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="AccountLabel" Grid.Row="0" Text="Compte" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="AccountBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="OnAccountChanged" />

            <TextBlock Grid.Row="1" Text="Agenda" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CalendarBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

            <TextBlock Grid.Row="2" Text="Date" Style="{StaticResource FieldLabel}" />
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                <CheckBox x:Name="AllDayBox" DockPanel.Dock="Right" Content="Journée entière" Margin="12,0,0,0"
                          Checked="OnAllDayChanged" Unchecked="OnAllDayChanged" />
                <DatePicker x:Name="DateBox" />
            </DockPanel>

            <TextBlock Grid.Row="3" Text="Horaire" Style="{StaticResource FieldLabel}" />
            <StackPanel x:Name="TimePanel" Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="StartBox" Width="80" ToolTip="ex. 14:30" />
                <TextBlock Text="→" VerticalAlignment="Center" Margin="10,0" />
                <TextBox x:Name="EndBox" Width="80" ToolTip="ex. 15:30" />
            </StackPanel>

            <TextBlock Grid.Row="4" Text="Rappel" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ReminderBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />

            <TextBlock Grid.Row="5" Text="Lieu" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="LocationBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />

            <TextBlock Grid.Row="6" Text="Description" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,16,0" />
            <TextBox x:Name="DescriptionBox" Grid.Row="6" Grid.Column="1" Height="72" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" IsCancel="True" Width="100" Margin="0,0,8,0" />
            <Button x:Name="CreateButton" Content="Créer" IsDefault="True" Width="100"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnCreate" />
        </StackPanel>
    </StackPanel>
</Window>
