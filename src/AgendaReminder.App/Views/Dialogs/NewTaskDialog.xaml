<Window x:Class="AgendaReminder.App.Views.Dialogs.NewTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle tâche"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22,18,22,18">
        <TextBox x:Name="TitleBox" FontSize="15" Margin="0,0,0,14" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="AccountLabel" Grid.Row="0" Text="Compte" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="AccountBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="OnAccountChanged" />

            <TextBlock Grid.Row="1" Text="Liste" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TaskListBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

            <TextBlock Grid.Row="2" Text="Échéance" Style="{StaticResource FieldLabel}" />
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                <CheckBox x:Name="HasDueBox" DockPanel.Dock="Left" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"
                          Checked="OnHasDueChanged" Unchecked="OnHasDueChanged" />
                <DatePicker x:Name="DateBox" />
            </DockPanel>

            <TextBlock Grid.Row="3" Text="Heure" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                <TextBox x:Name="TimeBox" Width="80" HorizontalAlignment="Left" ToolTip="Optionnel, ex. 14:30" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Optionnel. Enregistrée dans les notes (« ⏰ 14:30 ») car Google Tasks ne stocke pas l'heure." />
            </StackPanel>

            <TextBlock Grid.Row="4" Text="Notes" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,16,0" />
            <TextBox x:Name="NotesBox" Grid.Row="4" Grid.Column="1" Height="72" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" IsCancel="True" Width="100" Margin="0,0,8,0" />
            <Button x:Name="CreateButton" Content="Créer" IsDefault="True" Width="100"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnCreate" />
        </StackPanel>
    </StackPanel>
</Window>
