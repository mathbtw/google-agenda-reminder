<Window x:Class="AgendaReminder.App.Views.FullScreenReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rappel"
        ThemeMode="None"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#EB0E0F12"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Opacity="0">
    <Grid>
        <!-- Horloge discrète en haut -->
        <TextBlock x:Name="Clock" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0"
                   FontSize="20" FontWeight="Light" Foreground="#66FFFFFF" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="900" Margin="40">
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,44" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding Accent}">
                                <Run Text="{Binding Glyph, Mode=OneWay}" />
                                <Run Text=" " />
                                <Run Text="{Binding KindLabel, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" FontSize="52" FontWeight="SemiBold" Foreground="White"
                                       Margin="0,12,0,10" />
                            <TextBlock HorizontalAlignment="Center" FontSize="22" Foreground="#B3FFFFFF">
                                <Run Text="{Binding WhenText, Mode=OneWay}" />
                                <Run Text="   " />
                                <Run Text="{Binding RelativeText, Mode=OneWay}" Foreground="{Binding Accent, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Details}" HorizontalAlignment="Center" FontSize="16"
                                       Foreground="#80FFFFFF" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0" />

            <TextBlock HorizontalAlignment="Center" Margin="0,22,0,0" FontSize="12" Foreground="#4DFFFFFF"
                       Text="Entrée ou Échap pour fermer" />
        </StackPanel>
    </Grid>
</Window>
