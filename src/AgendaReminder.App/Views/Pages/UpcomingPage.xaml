<UserControl x:Class="AgendaReminder.App.Views.Pages.UpcomingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:AgendaReminder.App.Views.Pages">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type p:DayHeader}">
            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" Margin="2,14,0,8" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type p:UpcomingRow}">
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <!-- Largeur commune à toutes les lignes, ajustée au plus long horaire -->
                        <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="TimeColumn" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="8,0,0,8" />
                    <StackPanel Grid.Column="1" Margin="14,10,18,10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Caption}" Foreground="{Binding Accent}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,10,8,10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource RowIconButton}" Content="&#xE8FB;" ToolTip="Marquer comme terminée"
                                Visibility="{Binding CompleteVisibility}" Click="OnComplete" />
                        <Button Style="{StaticResource RowIconButton}" Content="&#xE8A7;" ToolTip="Ouvrir dans Google"
                                Visibility="{Binding OpenVisibility}" Click="OnOpen" />
                        <Button Style="{StaticResource RowIconButton}" Content="&#xE74D;" ToolTip="Supprimer"
                                Visibility="{Binding DeleteVisibility}" Click="OnDelete" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="OnNewEvent" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" VerticalAlignment="Center" />
                        <TextBlock Text="Évènement" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Click="OnNewTask" Style="{DynamicResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" VerticalAlignment="Center" />
                        <TextBlock Text="Tâche" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="À venir" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <TextBlock x:Name="Hint" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl x:Name="List" Grid.IsSharedSizeScope="True" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
