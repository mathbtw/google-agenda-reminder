<UserControl x:Class="AgendaReminder.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:AgendaReminder.App.Views">
    <UserControl.Resources>
        <!-- Ligne "libellé à gauche, contrôle à droite" -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="LastChildFill" Value="False" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SavedText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Annuler les modifications" Margin="0,0,8,0" Click="OnRevert" />
                <Button Content="Enregistrer" Style="{DynamicResource AccentButtonStyle}" Click="OnSave" />
            </StackPanel>
            <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <!-- Rappels : notification et plein écran, chacun à ses moments -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Rappels" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,-6,0,14"
                                   Text="Cochez la notification et/ou le plein écran, chacun avec son propre délai (ex. notification 10 min avant, puis plein écran 2 min avant). Minutes avant le début (évènements), l'heure de la tâche, ou l'heure de rappel (anniversaires). Plusieurs délais possibles : « 10, 30 »." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="130" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Évènements" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,10">
                                <CheckBox x:Name="EventNotifOn" Content="Notification" Width="120" VerticalAlignment="Center"
                                          Checked="OnFormToggled" Unchecked="OnFormToggled" />
                                <TextBox x:Name="EventNotif" Width="80" />
                                <TextBlock Text="min avant" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,24,10">
                                <CheckBox x:Name="EventFullOn" Content="Plein écran" Width="120" VerticalAlignment="Center"
                                          Checked="OnFormToggled" Unchecked="OnFormToggled" />
                                <TextBox x:Name="EventFull" Width="80" />
                                <TextBlock Text="min avant" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <Button x:Name="EventColor" Grid.Row="0" Grid.Column="3" Tag="Event" Click="OnPickColor"
                                    Width="64" Height="32" Margin="0,0,0,10" ToolTip="Choisir la couleur" />

                            <TextBlock Grid.Row="1" Text="Tâches" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,10">
                                <CheckBox x:Name="TaskNotifOn" Content="Notification" Width="120" VerticalAlignment="Center"
                                          Checked="OnFormToggled" Unchecked="OnFormToggled" />
                                <TextBox x:Name="TaskNotif" Width="80" />
                                <TextBlock Text="min avant" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,24,10">
                                <CheckBox x:Name="TaskFullOn" Content="Plein écran" Width="120" VerticalAlignment="Center"
                                          Checked="OnFormToggled" Unchecked="OnFormToggled" />
                                <TextBox x:Name="TaskFull" Width="80" />
                                <TextBlock Text="min avant" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <Button x:Name="TaskColor" Grid.Row="1" Grid.Column="3" Tag="Task" Click="OnPickColor"
                                    Width="64" Height="32" Margin="0,0,0,10" ToolTip="Choisir la couleur" />

                            <TextBlock Grid.Row="2" Text="Anniversaires" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,10">
                                <CheckBox x:Name="BirthdayNotifOn" Content="Notification" Width="120" VerticalAlignment="Center"
                                          Checked="OnFormToggled" Unchecked="OnFormToggled" />
                                <TextBox x:Name="BirthdayNotif" Width="80" />
                                <TextBlock Text="min avant" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,0,24,10">
                                <CheckBox x:Name="BirthdayFullOn" Content="Plein écran" Width="120" VerticalAlignment="Center"
                                          Checked="OnFormToggled" Unchecked="OnFormToggled" />
                                <TextBox x:Name="BirthdayFull" Width="80" />
                                <TextBlock Text="min avant" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <Button x:Name="BirthdayColor" Grid.Row="2" Grid.Column="3" Tag="Birthday" Click="OnPickColor"
                                    Width="64" Height="32" Margin="0,0,0,10" ToolTip="Choisir la couleur" />
                        </Grid>

                        <!-- Sélecteur de couleur (affiché sous le tableau) -->
                        <Border x:Name="ColorPanel" Visibility="Collapsed" Margin="0,4,0,12" Padding="12" CornerRadius="6"
                                BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock x:Name="ColorPanelTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <WrapPanel x:Name="PaletteHost" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Personnalisée :" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="HexBox" Width="110" ToolTip="#RRGGBB" />
                                    <Button Content="Appliquer" Margin="8,0,0,0" Click="OnApplyHex" />
                                    <Button Content="Fermer" Margin="8,0,0,0" Click="OnCloseColor" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Rappels déjà définis dans Google sur les évènements" />
                            <ComboBox x:Name="GoogleStyle" DockPanel.Dock="Right" Width="220"
                                      ItemsSource="{x:Static v:Choices.GoogleReminderStyles}" SelectedValuePath="Value" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="UseGoogleColors" Content="Évènements : utiliser la couleur de Google Agenda (évènement ou agenda)" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Heure de rappel des évènements « journée entière »" />
                            <TextBox x:Name="AllDayTime" DockPanel.Dock="Right" Width="140" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Heure de rappel des anniversaires" />
                            <TextBox x:Name="BirthdayTime" DockPanel.Dock="Right" Width="140" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Heure des tâches sans heure connue" />
                            <TextBox x:Name="TaskTime" DockPanel.Dock="Right" Width="140" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Rappel manqué (PC éteint/en veille) encore affiché s'il a moins de (min)" />
                            <TextBox x:Name="GraceMinutes" DockPanel.Dock="Right" Width="140" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Notifications et plein écran" Style="{StaticResource SectionTitle}" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Durée d'affichage des notifications (secondes, 0 = jusqu'à fermeture)" />
                            <TextBox x:Name="ToastSeconds" DockPanel.Dock="Right" Width="140" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Boutons « Rappeler dans » (minutes, ex. 5, 10, 30)" />
                            <TextBox x:Name="SnoozeOptions" DockPanel.Dock="Right" Width="140" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}" Margin="0,0,0,0">
                            <CheckBox x:Name="PlaySound" Content="Jouer un son" />
                            <Button DockPanel.Dock="Right" Content="Tester le plein écran" Click="OnTestFullScreen" />
                            <Button DockPanel.Dock="Right" Content="Tester une notification" Margin="0,0,8,0" Click="OnTestToast" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Blacklist -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Applications qui bloquent les rappels" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,-6,0,12"
                                   Text="Quand une de ces applications est au premier plan, le rappel est adapté." />

                        <ItemsControl x:Name="BlacklistItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource RowIconButton}" Content="&#xE74D;"
                                                ToolTip="Retirer" Click="OnRemoveBlacklist" />
                                        <ComboBox DockPanel.Dock="Right" Width="300" Margin="8,0,0,0"
                                                  ItemsSource="{x:Static v:Choices.BlacklistActions}" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Action}" />
                                        <TextBox Text="{Binding Process, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,4,0,14">
                            <Button DockPanel.Dock="Right" Content="Ajouter" Margin="8,0,0,0" Click="OnAddBlacklist" />
                            <ComboBox x:Name="ProcessPicker" IsEditable="True" DropDownOpened="OnProcessPickerOpened"
                                      ToolTip="Choisissez une application ouverte ou tapez un nom (ex. valorant.exe)" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="AutoDetect" Content="Détecter aussi les jeux plein écran, présentations et appels" />
                            <ComboBox x:Name="AutoDetectAction" DockPanel.Dock="Right" Width="300"
                                      ItemsSource="{x:Static v:Choices.BlacklistActions}" SelectedValuePath="Value" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Un rappel reporté s'affiche quand même en notification après (min)" />
                            <TextBox x:Name="MaxPostpone" DockPanel.Dock="Right" Width="140" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Synchronisation -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Synchronisation" Style="{StaticResource SectionTitle}" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Synchroniser toutes les (minutes)" />
                            <TextBox x:Name="SyncMinutes" DockPanel.Dock="Right" Width="140" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre de jours récupérés à l'avance" />
                            <TextBox x:Name="LookAhead" DockPanel.Dock="Right" Width="140" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Module web -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Heure réelle des tâches (module web, expérimental)" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,-6,0,12"
                                   Text="Lit l'heure des tâches sur le site Google Agenda via un navigateur intégré invisible. Non officiel : peut cesser de fonctionner si Google modifie son site. La session web donne accès à tout le compte Google." />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="WebEnabled" Content="Activer" />
                            <Button DockPanel.Dock="Right" Content="Lire maintenant" Click="OnWebRead" />
                            <Button DockPanel.Dock="Right" Content="Se connecter au site Google…" Margin="0,0,8,0" Click="OnWebLogin" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Lecture toutes les (minutes)" />
                            <TextBox x:Name="WebMinutes" DockPanel.Dock="Right" Width="140" />
                        </DockPanel>
                        <TextBlock x:Name="WebStatus" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>

                <!-- Mises à jour -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Mises à jour" Style="{StaticResource SectionTitle}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="AutoUpdate" Content="Rechercher automatiquement les nouvelles versions" />
                            <Button x:Name="InstallUpdateButton" DockPanel.Dock="Right" Content="Installer la mise à jour"
                                    Style="{DynamicResource AccentButtonStyle}" Visibility="Collapsed" Click="OnInstallUpdate" />
                            <Button DockPanel.Dock="Right" Content="Rechercher maintenant" Margin="0,0,8,0" Click="OnCheckUpdate" />
                        </DockPanel>
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>

                <!-- Système -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Système" Style="{StaticResource SectionTitle}" />
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="StartWithWindows" Content="Lancer au démarrage de Windows" Click="OnStartupToggled" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="Ouvrir le dossier des données" Click="OnOpenData" />
                            <Button DockPanel.Dock="Right" Content="settings.json (avancé)" Margin="0,0,8,0" Click="OnOpenJson" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
