<UserControl x:Class="AgendaReminder.App.Views.Pages.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:AgendaReminder.App.Views.Pages">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type p:DayHeader}">
            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" Margin="2,14,0,8" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type p:TaskRow}">
            <Border Style="{StaticResource Card}" Padding="8,6" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource RowIconButton}" Content="&#xEA3A;" FontSize="18"
                            ToolTip="Marquer comme terminée" Margin="0,0,8,0" Click="OnComplete" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource RowIconButton}" Content="&#xE8A7;" ToolTip="Ouvrir dans Google"
                                Visibility="{Binding OpenVisibility}" Click="OnOpen" />
                        <Button Style="{StaticResource RowIconButton}" Content="&#xE74D;" ToolTip="Supprimer" Click="OnDelete" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="OnReload" Margin="0,0,8,0" ToolTip="Actualiser">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" />
                </Button>
                <Button Click="OnNewTask" Style="{DynamicResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" VerticalAlignment="Center" />
                        <TextBlock Text="Tâche" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="Tâches" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <TextBlock x:Name="Hint" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl x:Name="List" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
