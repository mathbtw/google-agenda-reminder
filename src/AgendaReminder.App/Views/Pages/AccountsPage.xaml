<UserControl x:Class="AgendaReminder.App.Views.Pages.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Comptes" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <!-- Étape 1 : identifiants OAuth -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Guide pas à pas" Margin="0,0,8,0" Click="OnGuide" />
                            <Button x:Name="ImportButton" Content="Importer client_secret.json…" Click="OnImport" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="1. Identifiants Google (OAuth)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock x:Name="SecretStatus" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Étape 2 : comptes -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="AddButton" DockPanel.Dock="Right" Click="OnAdd" Style="{DynamicResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" VerticalAlignment="Center" />
                                    <TextBlock Text="Ajouter un compte" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="2. Comptes Google" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Connexion en cours -->
                        <Border x:Name="PendingPanel" Visibility="Collapsed" Margin="0,4,0,8" Padding="12"
                                CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Annuler" Click="OnCancelAdd" />
                                <TextBlock Text="Terminez la connexion dans le navigateur qui vient de s'ouvrir…"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <TextBlock x:Name="NoAccount" Style="{StaticResource Muted}"
                                   Text="Aucun compte. Ajoutez-en un : votre navigateur s'ouvrira pour autoriser l'accès à Google Agenda et Google Tasks." />

                        <ItemsControl x:Name="AccountList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="0,10">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox Content="Rappels actifs" IsChecked="{Binding Enabled, Mode=OneWay}"
                                                          Click="OnToggleEnabled" Margin="0,0,16,0" VerticalAlignment="Center" />
                                                <Button Content="Reconnecter" Margin="0,0,8,0" Click="OnReconnect" />
                                                <Button Content="Supprimer" Click="OnRemove" />
                                            </StackPanel>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" FontSize="20"
                                                       VerticalAlignment="Center" Margin="2,0,14,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Email}" FontSize="14" />
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Foreground="{Binding StatusBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Caption}" Margin="4,0,0,0"
                           Text="Les rappels de tous les comptes actifs sont combinés. Le sélecteur « Compte affiché » (à gauche) filtre l'affichage et choisit le compte utilisé pour créer des éléments." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
