<Window x:Class="AgendaReminder.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rappel"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Opacity="0">
    <Border Margin="10"
            CornerRadius="10"
            Background="#F21C1D21"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            MouseLeftButtonUp="OnBodyClick"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="10,0,0,10" Background="{Binding Accent}" />

            <StackPanel Grid.Column="1" Margin="14,12,14,12">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="12" Margin="0,0,6,0" Foreground="{Binding Accent}" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding Accent}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource GhostButton}"
                            Padding="6,0" FontSize="11" Click="OnDismiss" ToolTip="Fermer" />
                </DockPanel>

                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="White"
                           TextWrapping="Wrap" Margin="0,6,0,2" />

                <TextBlock Foreground="#B3FFFFFF" FontSize="12.5">
                    <Run Text="{Binding WhenText, Mode=OneWay}" />
                    <Run Text="  " />
                    <Run Text="{Binding RelativeText, Mode=OneWay}" Foreground="{Binding Accent, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Text="{Binding Details}" Foreground="#80FFFFFF" FontSize="11.5" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
