<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms uniquement pour l'icône de la zone de notification (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Permet de compiler depuis Linux/macOS (CI) ; l'exécution reste Windows uniquement. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgendaReminder.App</RootNamespace>
    <AssemblyName>AgendaReminder</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Module optionnel "heure des tâches" : navigateur intégré (runtime Edge WebView2, présent sur Windows 10/11). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgendaReminder.Core\AgendaReminder.Core.csproj" />
  </ItemGroup>

</Project>
